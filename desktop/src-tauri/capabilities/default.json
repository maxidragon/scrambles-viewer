{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: persisted competition state, and the extracted scramble PDFs under the app data directory. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "store:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/scramble_pdfs/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/scramble_pdfs/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/scramble_pdfs" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/scramble_pdfs" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/scramble_pdfs" }, { "path": "$APPDATA/scramble_pdfs/**" }]
    }
  ]
}
